# ============================================================
# Rota — environment configuration
# Copy this file to .env and adjust values for your setup.
# All variables have sensible defaults for local development.
# The dashboard is served by the core on the API port (same origin),
# so there is no separate dashboard service or API URL to configure.
# ============================================================

# ----------------------------------------------------------
# Ports (host-side; container ports are fixed)
# ----------------------------------------------------------
PROXY_PORT=8000       # Proxy server (the actual HTTP/SOCKS proxy)
API_PORT=8001         # REST API + dashboard UI (same origin)

# ----------------------------------------------------------
# Password (required)
# One shared password guards the proxy port, the API and the dashboard.
# Proxy clients send it as the Proxy-Authorization password; API clients as a
# Basic password, a Bearer token or ?token=. Rota refuses to start without it.
# ----------------------------------------------------------
ROTA_PASSWORD=change-me

# ----------------------------------------------------------
# Database (PostgreSQL 14+)
# ----------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=rota
DB_PASSWORD=rota_password
DB_NAME=rota
DB_SSLMODE=disable

# Request and tunnel history lives in Parquet files, not in the database:
# where (default data/events), and whether every append waits for the disk.
# Without sync, appends survive a Rota crash but power loss can lose what the
# OS has not written yet.
# EVENT_STORE_DIR=data/events
# EVENT_STORE_SYNC=false
# Names this instance's history files (<day>.<instance>.log and .parquet):
# lowercase letters, digits, hyphens and underscores. Keep it the same across
# restarts, because Rota converts only logs that carry its own name.
# EVENT_STORE_INSTANCE=rota

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
LOG_LEVEL=info   # debug | info | warn | error

# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to "*" for local development. Set explicit origins in production
# to lock the API down; doing so also enables credentialed CORS requests.
# This allowlist also governs which origins may open a dashboard WebSocket.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# ----------------------------------------------------------
# HTTPS interception (optional)
# ----------------------------------------------------------
# By default a CONNECT tunnel is opaque: Rota records ONE event when the tunnel
# opens, then shuttles encrypted bytes. A client using keep-alive or HTTP/2 can
# push thousands of requests through that single tunnel, so HTTPS request counts
# read far lower than the traffic actually sent. Tunnel bytes and lifetime are
# always recorded regardless of the settings below.
#
# Setting a CA here makes interception POSSIBLE, never automatic — a client
# requests it per connection with a "profile-<name>" option in its proxy
# username. Clients that want to own their own TLS simply leave it out.
# Requests for inspection fail with 594 and X-Rota-Error when inspection cannot
# run, rather than silently keeping the client's TLS.
#
# Requirements and caveats:
#   - The client must trust this CA, or every intercepted request fails its
#     certificate check.
#   - The target sees Rota's handshake rather than the client's: "go" presents
#     Go's stdlib fingerprint, or pick a real device — ios, ios18, android,
#     okhttp, chrome, firefox. See the README.
#   - Targets that pin certificates will fail regardless of trust: list them in
#     TLS_INSPECT_BYPASS_DOMAINS. Inspection requests to these targets return
#     594; connect without a profile for opaque access.
#
# Generate a CA (keep the key private — it can mint a certificate for any host):
#   openssl ecparam -genkey -name prime256v1 -out ca.key
#   openssl req -x509 -new -key ca.key -sha256 -days 825 -out ca.crt \
#     -subj "/CN=Rota Inspection CA" \
#     -addext "basicConstraints=critical,CA:TRUE" \
#     -addext "keyUsage=critical,keyCertSign,cRLSign"
#
# For Compose, use absolute host paths and include the read-only CA mounts:
#   docker compose -f docker-compose.yml -f docker-compose.tls-inspect.yml up -d
# The container runs as UID 1000; it must be able to read both files.
# For a standalone server, use paths readable by that process.
# TLS_INSPECT_CA_CERT=/etc/rota/ca.crt
# TLS_INSPECT_CA_KEY=/etc/rota/ca.key

# Hosts (and their subdomains) never intercepted, comma-separated.
# TLS_INSPECT_BYPASS_DOMAINS=accounts.google.com,api.pinned-service.com

# ----------------------------------------------------------
# GeoIP
# ----------------------------------------------------------
# Proxy locations (and ISPs) come from the free ip-api.com web service by
# default. To resolve them locally from MaxMind
# GeoLite2 databases instead, set a license key from a free MaxMind account
# (https://www.maxmind.com/en/geolite2/signup). rota downloads GeoLite2-City
# and GeoLite2-ASN into data/geoip/ and refreshes them every GEOIP_UPDATE_HOURS.
# MAXMIND_LICENSE_KEY=
# Optional: use MaxMind's account-authenticated download endpoint.
# MAXMIND_ACCOUNT_ID=
# GEOIP_UPDATE_HOURS=168
#
# Or point at databases kept current by something else (e.g. geoipupdate);
# rota reloads a file when it changes. The ASN database is optional.
# GEOIP_CITY_DB=/usr/share/GeoIP/GeoLite2-City.mmdb
# GEOIP_ASN_DB=/usr/share/GeoIP/GeoLite2-ASN.mmdb

# ----------------------------------------------------------
# Metrics (Prometheus + optional OTLP push)
# ----------------------------------------------------------
# Rota exposes operational metrics in Prometheus format at
# GET http://<host>:8001/metrics — proxy request/tunnel rates and latencies,
# fleet gauges, health checks, source fetches, auth rejections, API request
# stats and Go runtime metrics. Point any
# Prometheus-compatible scraper at it (Prometheus, SigNoz's collector,
# Grafana Alloy, ...).
METRICS_ENABLED=true

# Require "Authorization: Bearer <token>" on /metrics. Leave unset to keep the
# endpoint open (fine when the API port is internal-only).
# METRICS_BEARER_TOKEN=

# To PUSH metrics instead (no scraper needed), set the standard OpenTelemetry
# env vars — rota exports over OTLP whenever an endpoint is configured.
# Works with any OTLP backend; SigNoz examples:
#
# Self-hosted SigNoz (collector's OTLP HTTP port):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
# SigNoz Cloud:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
#   OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
#
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # or grpc (endpoint port 4317)
# OTEL_METRIC_EXPORT_INTERVAL=60000           # push interval in ms
# OTEL_SERVICE_NAME=rota                      # service.name resource attribute
