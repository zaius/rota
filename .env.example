# ============================================================
# Rota — environment configuration
# Copy this file to .env and adjust values for your setup.
# All variables have sensible defaults for local development.
# The dashboard is served by the core on the API port (same origin),
# so there is no separate dashboard service or API URL to configure.
# ============================================================

# ----------------------------------------------------------
# Ports (host-side; container ports are fixed)
# ----------------------------------------------------------
PROXY_PORT=8000       # Proxy server (the actual HTTP/SOCKS proxy)
API_PORT=8001         # REST API + dashboard UI (same origin)

# ----------------------------------------------------------
# Admin credentials for the web dashboard
# These are only used to seed the database on first start.
# After the first run you can change them via
# Settings → Admin Account in the dashboard UI.
# ----------------------------------------------------------
ROTA_ADMIN_USER=admin
ROTA_ADMIN_PASSWORD=admin

# ----------------------------------------------------------
# Database (Postgres 14+; TimescaleDB is an optional accelerator —
# when present, retention/compression run via native policies)
# ----------------------------------------------------------
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=rota
DB_PASSWORD=rota_password
DB_NAME=rota
DB_SSLMODE=disable

# Backend for time-series event data (system logs, per-request history):
# "postgres" (default — events live in the primary database) or "clickhouse".
# With clickhouse, start the optional service alongside the stack:
#   EVENT_STORE=clickhouse docker compose --profile clickhouse up -d
EVENT_STORE=postgres
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=rota
CLICKHOUSE_PASSWORD=rota_password
CLICKHOUSE_DB=rota

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
LOG_LEVEL=info   # debug | info | warn | error

# JWT secret used to sign dashboard session tokens. Leave unset for local
# development (a random secret is generated on each boot). In production —
# and REQUIRED for multi-replica deployments — set a long, stable random
# value so sessions survive restarts and are shared across instances.
# JWT_SECRET=

# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to "*" for local development. Set explicit origins in production
# to lock the API down; doing so also enables credentialed CORS requests.
# This allowlist also governs which origins may open a dashboard WebSocket.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# Derive the client IP from X-Forwarded-For / X-Real-IP. Enable this ONLY when
# the API sits behind a reverse proxy that overwrites those headers. If the API
# is exposed directly, leaving this off is what stops a client from spoofing a
# fresh IP on every login attempt to evade the per-IP block below.
# TRUST_PROXY_HEADERS=false

# ----------------------------------------------------------
# HTTPS interception (optional)
# ----------------------------------------------------------
# By default a CONNECT tunnel is opaque: Rota records ONE event when the tunnel
# opens, then shuttles encrypted bytes. A client using keep-alive or HTTP/2 can
# push thousands of requests through that single tunnel, so HTTPS request counts
# read far lower than the traffic actually sent. Tunnel bytes and lifetime are
# always recorded regardless of the settings below.
#
# Setting a CA here makes interception POSSIBLE, never automatic — each proxy
# user must also have inspect_tls enabled. Clients that want to own their own
# TLS simply stay opted out and get the untouched tunnel they get today.
#
# Requirements and caveats:
#   - The client must trust this CA, or every intercepted request fails its
#     certificate check.
#   - The target sees Rota's handshake rather than the client's. Which one it
#     sees is the user's tls_profile: "go" (the default) presents Go's stdlib
#     fingerprint, or pick a real device — ios, ios-18, android,
#     android-okhttp, chrome, firefox. Clients can override per connection with
#     a "-profile-<name>" suffix on the proxy username. See the README.
#   - Targets that pin certificates will fail regardless of trust: list them in
#     TLS_INSPECT_BYPASS_DOMAINS.
#
# Generate a CA (keep the key private — it can mint a certificate for any host):
#   openssl ecparam -genkey -name prime256v1 -out ca.key
#   openssl req -x509 -new -key ca.key -sha256 -days 825 -out ca.crt \
#     -subj "/CN=Rota Inspection CA" \
#     -addext "basicConstraints=critical,CA:TRUE" \
#     -addext "keyUsage=critical,keyCertSign,cRLSign"
#
# TLS_INSPECT_CA_CERT=/etc/rota/ca.crt
# TLS_INSPECT_CA_KEY=/etc/rota/ca.key

# Hosts (and their subdomains) never intercepted, comma-separated.
# TLS_INSPECT_BYPASS_DOMAINS=accounts.google.com,api.pinned-service.com

# ----------------------------------------------------------
# Auth brute-force protection
# ----------------------------------------------------------
# Per-IP: block an IP after AUTH_IP_MAX_ATTEMPTS failed logins
# within AUTH_IP_WINDOW_MINUTES minutes, for AUTH_IP_BLOCK_MINUTES minutes.
AUTH_IP_MAX_ATTEMPTS=10
AUTH_IP_WINDOW_MINUTES=10
AUTH_IP_BLOCK_MINUTES=30

# Global: if total login attempts across all IPs exceed
# AUTH_GLOBAL_MAX_PER_MINUTE per minute, the login endpoint is
# locked for AUTH_GLOBAL_LOCKOUT_MINUTES minutes for everyone.
AUTH_GLOBAL_MAX_PER_MINUTE=1000
AUTH_GLOBAL_LOCKOUT_MINUTES=1
