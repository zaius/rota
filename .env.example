# Rota configuration. Copy to .env and set ROTA_PASSWORD.
# core/internal/config/config.go parses these variables.

# Guards the proxy port, the API and the dashboard. Proxy clients send it as
# the proxy password; API clients as a Basic password or a Bearer token.
# Rota refuses to start without it.
ROTA_PASSWORD=change-me

# Under Compose these are the host ports; the container's are fixed.
PROXY_PORT=8000   # the proxy
API_PORT=8001     # API and dashboard

# PostgreSQL 14+, which holds the configuration.
DB_HOST=postgres
DB_PORT=5432
DB_USER=rota
DB_PASSWORD=rota_password
DB_NAME=rota
DB_SSLMODE=disable

LOG_LEVEL=info   # debug | info | warn | error

# Browser origins allowed to call the API, comma-separated. The default "*"
# suits local development.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# ---- Request and tunnel history (Parquet files) ----

# Where the files live. Keep it on persistent storage, one Rota per directory.
# EVENT_STORE_DIR=data/events

# Names this instance's files (<day>.<instance>.log and .parquet): lowercase
# letters, digits, hyphens and underscores. Rota converts only logs carrying
# its own name, so keep it the same across restarts.
# EVENT_STORE_INSTANCE=rota

# Makes every append wait for the disk. Without it appends survive a Rota
# crash, but power loss can lose what the OS has not yet written.
# EVENT_STORE_SYNC=false

# ---- HTTPS inspection (optional; see docs/tls-inspection.md) ----

# PEM paths for the CA that signs certificates for inspected connections. Set
# both or neither. Inspection also needs a profile-<name> option in the
# client's proxy username, per connection.
# Under Compose, use absolute host paths and add docker-compose.tls-inspect.yml.
# TLS_INSPECT_CA_CERT=/etc/rota/ca.crt
# TLS_INSPECT_CA_KEY=/etc/rota/ca.key

# Hosts (and their subdomains) never inspected, comma-separated, for targets
# that pin certificates. A request to inspect one fails with 594.
# TLS_INSPECT_BYPASS_DOMAINS=accounts.google.com,api.pinned-service.com

# ---- Metrics ----

# Serves Prometheus metrics at GET :8001/metrics.
METRICS_ENABLED=true

# Requires "Authorization: Bearer <token>" on /metrics. Unset leaves it open,
# which is fine while the API port is internal.
# METRICS_BEARER_TOKEN=

# Rota also pushes the same metrics over OTLP when the standard OpenTelemetry
# variables name an endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # or grpc, on port 4317
# OTEL_METRIC_EXPORT_INTERVAL=60000           # milliseconds
# OTEL_SERVICE_NAME=rota
